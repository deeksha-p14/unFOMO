# noFOMO Environment Configuration (Placeholders only - Never commit live secrets)

PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# AI Provider Configuration: 'mock' (default, offline, zero-key) or 'gemini'
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here

# Default User Display Name for Mention Detection
DEFAULT_USER_DISPLAY_NAME=Alex

# Optional Database Persistence (Leave empty to use sandboxed in-memory store)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nofomo

# Connector Scaffolding & OAuth Placeholders (Optional)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/api/connectors/gmail/callback

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

TELEGRAM_BOT_TOKEN=
